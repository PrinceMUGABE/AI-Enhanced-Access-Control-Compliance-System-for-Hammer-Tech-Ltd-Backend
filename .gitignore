
# Add Python cache patterns to .gitignore
@"
# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# Django
*.log
*.pyc
db.sqlite3
db.sqlite3-journal
media/
staticfiles/

# Environment
.env
venv/
env/
ENV/
.venv

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
"@ | Out-File -FilePath .gitignore -Encoding UTF8